# ===========================================================================
# Chennai FloodSense AI — Backend Environment Variables
# ===========================================================================
#
# NEVER commit actual secrets to version control.
# Copy this file to .env and fill in your values.
# On Render: add these as Environment Variables in the dashboard.
#
# ---------------------------------------------------------------------------
# Supabase — service-role key (SECRET — backend only, never in frontend)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------------------------------------------------------
# CORS
# Set to your Vercel frontend URL to restrict cross-origin requests.
# Leave as * for local development.
# For multiple origins: FRONTEND_ORIGIN=https://app.vercel.app,http://localhost:5173
# ---------------------------------------------------------------------------
FRONTEND_ORIGIN=*
